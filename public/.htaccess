# Single-page app routing for Apache / LiteSpeed hosting (e.g. Hostinger):
# serve real files as-is, send every other path (/pricing, /login, /p/<token>, /o/<workspace>...) to index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
